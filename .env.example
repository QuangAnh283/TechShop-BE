NODE_ENV=development
PORT=3001
# Kết nối PostgreSQL native (tạo sẵn role+db 'datn' trên server 5432)
DATABASE_URL="postgresql://datn:datn@localhost:5432/datn?schema=public"

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES=7d

UPLOADS_DIR=uploads

VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPay chuyển hướng trình duyệt về trang FE; FE gọi lại backend để xác minh.
VNPAY_RETURN_URL=http://localhost:3002/payment/vnpay-return

APP_URL=http://localhost:3001
# URL frontend (dùng cho link xác thực email và VNPay return)
FRONTEND_URL=http://localhost:3002
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-gmail@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM=TechShop <your-gmail@gmail.com>

CORS_ORIGIN=http://localhost:3002

# Redis (cache + session) — chạy native trên localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Media upload (lưu local disk uploads/media), giới hạn dung lượng mỗi file (MB)
MEDIA_MAX_SIZE_MB=5

# Phí ship cố định; miễn phí khi tổng tiền hàng >= ngưỡng (VNĐ)
SHIPPING_FEE=30000
SHIPPING_FREE_THRESHOLD=10000000
