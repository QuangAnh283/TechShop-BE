# Dependencies
node_modules/

# Env & secrets — KHÔNG commit. Chỉ .env.example được lên repo.
.env
.env.*
!.env.example
*.local

# Build output
dist/
*.tsbuildinfo

# File nén — KHÔNG commit. `uploads.zip` là bản nén của chính thư mục `uploads/`,
# mà 299 ảnh trong đó đã được git theo dõi từng file; commit vào là nhồi thêm ~5,6 MB
# binary trùng lặp vào lịch sử repo và không xoá được bằng commit sau.
*.zip
*.rar
*.7z

# Logs
*.log
npm-debug.log*

# OS
Thumbs.db
.DS_Store

# Giữ lại CÓ CHỦ ĐÍCH (đừng thêm vào đây):
#   uploads/         — ảnh sản phẩm demo, thiếu nó thì web trống ảnh
#   prisma/seed.sql  — dữ liệu demo, thiếu nó thì `npm run db:seed` vô nghĩa
